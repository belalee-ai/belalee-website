---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

// Priority order: core expertise first
const priorityOrder: Record<string, number> = {
  "商业化": 1,
  "增长": 2,
  "出海": 3,
  "工作流": 4,
  "AI 转型": 5,
};

const posts = (await getCollection("blog")).sort((a, b) => {
  const pa = priorityOrder[a.data.badge || ""] || 99;
  const pb = priorityOrder[b.data.badge || ""] || 99;
  if (pa !== pb) return pa - pb;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-center hero-gradient">
      <!-- 柠檬气泡点缀（纯装饰，屏幕阅读器跳过）
           三层结构：外层吃鼠标视差，中层横向漂移，内层纵向浮动+呼吸 -->
      <div class="hero-deco" aria-hidden="true">
        <span class="hero-orb hero-orb--1"><b><i></i></b></span>
        <span class="hero-orb hero-orb--2"><b><i></i></b></span>
        <span class="hero-orb hero-orb--3"><b><i></i></b></span>
        <span class="hero-orb hero-orb--4"><b><i></i></b></span>
        <span class="hero-orb hero-orb--5"><b><i></i></b></span>
        <span class="hero-deco__cross"><b>+</b></span>
        <span class="hero-deco__pear"><b>🍐</b></span>
      </div>
      <div class="avatar mb-6">
        <div class="w-20 rounded-full ring-2 ring-accent/30 ring-offset-base-100 ring-offset-2 mx-auto">
          <img src="/profile.jpg" alt="梨贝拉" />
        </div>
      </div>
      <h1 class="text-4xl font-bold tracking-wide"><span class="inline-block">🍐</span>梨贝拉</h1>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 mt-6 text-lg tracking-widest">
        <span style="color: var(--ink);">效果广告</span>
        <span class="text-base-content/20">｜</span>
        <span style="color: var(--ink);">订阅商业化</span>
        <span class="text-base-content/20">｜</span>
        <span style="color: var(--ink);">出海增长</span>
      </div>
      <p class="text-base mt-7 text-base-content/60 leading-relaxed max-w-xl mx-auto">
        6年+ C端增长与商业化实战，前拼多多/TEMU · 美图秀秀 · 瑞幸咖啡<br/>
        打造AI时代的增长飞轮
      </p>
      <div class="flex gap-4 justify-center mt-10">
        <a href="/contact" class="btn btn-sm gap-1 hero-btn hero-btn-primary">联系我 <span class="text-xs">→</span></a>
        <a href="/cv" class="btn btn-sm btn-ghost gap-1 hero-btn">查看简历 <span class="text-xs">→</span></a>
      </div>
    </div>

    <!-- 数据大字报 — 瑞士风成就数字区 -->
    <div class="home-stats" aria-label="核心成绩">
      <div class="home-stat">
        <span class="home-stat__num" data-count="6" data-suffix="年+">6年+</span>
        <span class="home-stat__label">C端增长实战</span>
      </div>
      <div class="home-stat">
        <span class="home-stat__num" data-count="40" data-prefix="+" data-suffix="%">+40%</span>
        <span class="home-stat__label">订阅付费收入提升</span>
      </div>
      <div class="home-stat">
        <span class="home-stat__num" data-count="10" data-prefix="$" data-suffix="K+">$10K+</span>
        <span class="home-stat__label">单条广告日花费</span>
      </div>
      <div class="home-stat">
        <span class="home-stat__num" data-count="100" data-suffix="%+">100%+</span>
        <span class="home-stat__label">ROAS 稳定回报</span>
      </div>
    </div>
  </div>

  <div class="home-sections">
    <!-- AI 洞察 -->
    <div class="home-section">
      <div class="home-section__header">
        <h2 class="home-section__title">AI 洞察</h2>
        <a href="/blog" class="home-section__more">All →</a>
      </div>
      <div class="home-insights">
        {posts.map((post, i) => (
          <a href={"/blog/" + createSlug(post.data.title, post.slug)} class="home-insight-item">
            <span class="home-insight-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="home-insight-badge">{post.data.badge}</span>
            <span class="home-insight-title">{post.data.title}</span>
            <span class="home-insight-arrow">→</span>
          </a>
        ))}
      </div>
    </div>

    <!-- AI 实验室 -->
    <div class="home-section">
      <div class="home-section__header">
        <h2 class="home-section__title">AI 实验室</h2>
        <a href="/ai-lab" class="home-section__more">All →</a>
      </div>
      <div class="home-carousel" id="home-carousel" role="region" tabindex="0" aria-roledescription="轮播" aria-label="精选项目轮播">
        <button class="carousel-arrow carousel-arrow--left" id="carousel-prev" aria-label="上一个">‹</button>
        <button class="carousel-arrow carousel-arrow--right" id="carousel-next" aria-label="下一个">›</button>
        <div class="home-carousel__track" id="home-carousel-track">
          <a href="/ai-lab/personal-site" class="home-carousel__slide">
            <div class="home-lab-card__cover">
              <img src="/works/site-cover.png" alt="AI 协作建站" loading="lazy" />
            </div>
            <div class="home-lab-card__body">
              <span class="home-lab-card__status">已上线</span>
              <h3 class="home-lab-card__title">AI 协作建站</h3>
              <p class="home-lab-card__desc">零代码基础，全程 AI 协作完成设计、开发、内容</p>
              <div class="home-lab-card__tools">
                <span>Claude</span><span>Astro</span><span>Vercel</span>
              </div>
            </div>
          </a>
          <div class="home-carousel__slide home-carousel__slide--soon">
            <div class="home-lab-card__cover home-lab-card__cover--placeholder"><span>📈</span></div>
            <div class="home-lab-card__body">
              <span class="home-lab-card__status home-lab-card__status--soon">筹备中</span>
              <h3 class="home-lab-card__title">AI 增长实验看板</h3>
              <p class="home-lab-card__desc">基于 AI 的增长数据分析与实验管理工具</p>
              <div class="home-lab-card__tools"><span>Claude</span><span>React</span></div>
            </div>
          </div>
          <div class="home-carousel__slide home-carousel__slide--soon">
            <div class="home-lab-card__cover home-lab-card__cover--placeholder"><span>📝</span></div>
            <div class="home-lab-card__body">
              <span class="home-lab-card__status home-lab-card__status--soon">筹备中</span>
              <h3 class="home-lab-card__title">Prompt 工作流模板库</h3>
              <p class="home-lab-card__desc">产品经理常用 Prompt 模板与自动化工作流</p>
              <div class="home-lab-card__tools"><span>ChatGPT</span><span>Claude</span></div>
            </div>
          </div>
        </div>
        <div class="home-carousel__dots" id="home-carousel-dots">
          <button class="home-carousel__dot active" data-index="0" aria-label="幻灯片 1" type="button"></button>
          <button class="home-carousel__dot" data-index="1" aria-label="幻灯片 2" type="button"></button>
          <button class="home-carousel__dot" data-index="2" aria-label="幻灯片 3" type="button"></button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      var track = document.getElementById('home-carousel-track');
      var dots = document.querySelectorAll('#home-carousel-dots .home-carousel__dot');
      var prevBtn = document.getElementById('carousel-prev');
      var nextBtn = document.getElementById('carousel-next');
      if (!track || dots.length === 0) return;

      // Count real slides (excluding placeholders would be a design choice;
      // here we guard against the degenerate case of a single slide total).
      var slides = track.querySelectorAll('.home-carousel__slide');
      if (slides.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        var dotsEl = document.getElementById('home-carousel-dots');
        if (dotsEl) dotsEl.style.display = 'none';
        return;
      }

      var current = 0;
      var total = dots.length;
      var timer;
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function goTo(index) {
        current = ((index % total) + total) % total;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        dots.forEach(function(d, i) {
          if (i === current) d.classList.add('active');
          else d.classList.remove('active');
        });
      }

      function startAuto() {
        if (prefersReducedMotion) return;
        timer = setInterval(function() { goTo(current + 1); }, 4000);
      }

      function resetAuto() {
        clearInterval(timer);
        startAuto();
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          goTo(parseInt(dot.getAttribute('data-index') || '0'));
          resetAuto();
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          goTo(current - 1);
          resetAuto();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          goTo(current + 1);
          resetAuto();
        });
      }

      startAuto();

      // Pause auto-play on hover/focus (WCAG 2.2.2)
      var carousel = document.getElementById('home-carousel');
      if (carousel) {
        carousel.addEventListener('mouseenter', function() { clearInterval(timer); });
        carousel.addEventListener('mouseleave', function() { resetAuto(); });
        carousel.addEventListener('focusin', function() { clearInterval(timer); });
        carousel.addEventListener('focusout', function() { resetAuto(); });

        // Keyboard navigation (WCAG 2.1.1)
        carousel.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            goTo(current - 1);
            resetAuto();
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            goTo(current + 1);
            resetAuto();
          } else if (e.key === 'Home') {
            e.preventDefault();
            goTo(0);
            resetAuto();
          } else if (e.key === 'End') {
            e.preventDefault();
            goTo(total - 1);
            resetAuto();
          }
        });

        // Touch swipe support
        var touchStartX = 0;
        var touchStartY = 0;
        var touchEndX = 0;
        var touchEndY = 0;
        carousel.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });
        carousel.addEventListener('touchend', function(e) {
          touchEndX = e.changedTouches[0].screenX;
          touchEndY = e.changedTouches[0].screenY;
          var deltaX = touchEndX - touchStartX;
          var deltaY = touchEndY - touchStartY;
          if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
            if (deltaX < 0) {
              goTo(current + 1);
            } else {
              goTo(current - 1);
            }
            resetAuto();
          }
        }, { passive: true });
      }
    });
  </script>

  <script is:inline>
    // Hero 气泡鼠标视差 — 仅桌面指针设备，移出平滑回位
    document.addEventListener('astro:page-load', function() {
      var hero = document.querySelector('.hero-gradient');
      var deco = document.querySelector('.hero-deco');
      if (!hero || !deco) return;
      if (!window.matchMedia('(hover: hover)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      hero.addEventListener('pointermove', function(e) {
        var r = hero.getBoundingClientRect();
        // 鼠标相对 hero 中心的偏移，归一化后放大成 px 基准量
        var mx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        var my = ((e.clientY - r.top) / r.height - 0.5) * 2;
        deco.style.setProperty('--mx', (mx * 160).toFixed(1) + 'px');
        deco.style.setProperty('--my', (my * 110).toFixed(1) + 'px');
      }, { passive: true });

      hero.addEventListener('pointerleave', function() {
        deco.style.setProperty('--mx', '0px');
        deco.style.setProperty('--my', '0px');
      }, { passive: true });
    });
  </script>
</BaseLayout>
